# ─────────── Moolre ───────────
MOOLRE_API_USER=
MOOLRE_API_KEY=            # Private key (disbursements) — BACKEND ONLY, never ship to frontend
MOOLRE_API_PUBKEY=         # Public key (collections / payment links)
MOOLRE_API_VASKEY=         # VAS key (SMS)
MOOLRE_ACCOUNT_NUMBER=     # FarmClient master Moolre account
MOOLRE_SENDER_ID=FarmClient
MOOLRE_BASE_URL=https://api.moolre.com
MOOLRE_SANDBOX_URL=https://sandbox.moolre.com
USE_SANDBOX=true           # true => calls go to sandbox; only X-API-USER required there

# ─────────── Firebase (Admin SDK) ───────────
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=      # keep the literal \n escapes; they are unescaped at runtime

# ─────────── Database (Supabase Postgres) ───────────
# Pooled connection (pgbouncer, port 6543) — used by the app at runtime / serverless.
DATABASE_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1
# Direct connection (port 5432) — used by prisma migrate only.
DIRECT_URL=postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ─────────── Redis (Upstash REST) ───────────
REDIS_URL=                 # Upstash Redis REST URL
REDIS_TOKEN=               # Upstash Redis REST token

# ─────────── App ───────────
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=24h
NODE_ENV=development
PORT=3001
API_URL=http://localhost:3001
FRONTEND_URL=http://localhost:3000
PLATFORM_FEE_PERCENT=3
WEBHOOK_SECRET=            # shared secret for Moolre webhook verification

# ─────────── AI price microservice ───────────
AI_SERVICE_URL=http://localhost:8000

# ─────────── Cloudinary (produce photo uploads) ───────────
CLOUDINARY_URL=            # cloudinary://<api_key>:<api_secret>@<cloud_name>

# ─────────── Admin bootstrap (optional) ───────────
ADMIN_EMAILS=             # comma-separated emails granted admin role on sign-in

# ─────────── Cron (Vercel) ───────────
CRON_SECRET=              # Vercel Cron sends `Authorization: Bearer ${CRON_SECRET}`
DISABLE_NODE_CRON=true    # set true on Vercel (HTTP cron used instead of node-cron)
