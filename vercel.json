{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npx prisma generate",
  "functions": {
    "api/index.ts": {
      "maxDuration": 30
    }
  },
  "rewrites": [{ "source": "/(.*)", "destination": "/api/index" }],
  "crons": [
    { "path": "/jobs/auto-confirm", "schedule": "0 10 * * *" },
    { "path": "/jobs/price-alerts", "schedule": "0 7 * * *" }
  ]
}
